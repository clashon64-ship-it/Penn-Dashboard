# ─── Data source ────────────────────────────────────────────────────────────
# The dashboard picks a source in this order:
#   1. Google Sheets  (if VITE_GOOGLE_SHEET_ID + VITE_GOOGLE_API_KEY are set)
#   2. REST API       (if VITE_API_BASE_URL is set)
#   3. Sample data    (built-in fallback, used when nothing is configured)

# ─── Google Sheets (primary) ──────────────────────────────────────────────────
# The spreadsheet ID from its URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Share the sheet as "Anyone with the link can view", and create an API key
# (Google Cloud Console) with the Google Sheets API enabled.
VITE_GOOGLE_SHEET_ID=
VITE_GOOGLE_API_KEY=

# Optional: override the tab (worksheet) names. Defaults shown.
VITE_SHEET_TAB_KPIS=KPIs
VITE_SHEET_TAB_TIMESERIES=Timeseries
VITE_SHEET_TAB_CATEGORIES=Categories
VITE_SHEET_TAB_TRANSACTIONS=Transactions

# ─── Generic REST API (fallback option) ───────────────────────────────────────
# Expects a single endpoint: GET {VITE_API_BASE_URL}/dashboard
VITE_API_BASE_URL=
VITE_API_TOKEN=
