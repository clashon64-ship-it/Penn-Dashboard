# The spreadsheet ID from its URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Path to the Google service-account JSON key file (downloaded from Google
# Cloud Console). The service account's email must be granted Viewer access to
# the sheet via normal Share — the sheet stays private otherwise.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Range to read. Columns A:S map to the contact fields (see index.js COLUMNS).
SHEET_RANGE=Sheet1!A:S

# Server port and the browser origin allowed to call this proxy (your frontend).
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173

# How long (seconds) to cache the sheet read before refetching.
CACHE_TTL_SECONDS=60
